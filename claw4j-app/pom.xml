<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.claw4j</groupId>
        <artifactId>claw4j</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>claw4j-app</artifactId>
    <name>Claw4J :: App</name>
    <description>启动、配置与容器编排，唯一把各模块装配到一起的地方</description>

    <dependencies>
        <dependency>
            <groupId>io.github.claw4j</groupId>
            <artifactId>claw4j-domain</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.claw4j</groupId>
            <artifactId>claw4j-agent</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.claw4j</groupId>
            <artifactId>claw4j-tools</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.claw4j</groupId>
            <artifactId>claw4j-channel</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 只在本地开发时生效，不进产物，见 ADR-0005 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-docker-compose</artifactId>
            <scope>developmentOnly</scope>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!--
          真实供应商不放进默认依赖：DeepSeek 的自动配置在缺 key 时会直接抛异常，
          那样"没有 key 也要能启动"（ADR-0006）就守不住。拿到 key 后：
              mvn -Preal-model ...
              CLAW4J_MODEL_MOCK=false DEEPSEEK_API_KEY=sk-xxx
        -->
        <profile>
            <id>real-model</id>
            <dependencies>
                <dependency>
                    <groupId>org.springframework.ai</groupId>
                    <artifactId>spring-ai-starter-model-deepseek</artifactId>
                </dependency>
            </dependencies>
        </profile>
        <!--
          飞书 SDK 在 claw4j-channel 里是 optional，不会传递到这里。
          要飞书通道就必须显式声明，否则打出的产物不含飞书能力（也就不会白白带上它的传递依赖）。
          M2 做飞书长连接时启用：-Pchannel-feishu
        -->
        <profile>
            <id>channel-feishu</id>
            <dependencies>
                <dependency>
                    <groupId>com.larksuite.oapi</groupId>
                    <artifactId>oapi-sdk</artifactId>
                </dependency>
            </dependencies>
        </profile>
    </profiles>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <!-- 父 POM 用 BOM import 而不是继承 starter parent，repackage 必须显式绑定 -->
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
