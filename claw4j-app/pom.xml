<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.claw4j</groupId>
        <artifactId>claw4j</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>claw4j-app</artifactId>
    <name>Claw4J :: App</name>
    <description>启动、配置与容器编排，唯一把各模块装配到一起的地方</description>

    <dependencies>
        <dependency>
            <groupId>io.github.claw4j</groupId>
            <artifactId>claw4j-domain</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.claw4j</groupId>
            <artifactId>claw4j-agent</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.claw4j</groupId>
            <artifactId>claw4j-tools</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.claw4j</groupId>
            <artifactId>claw4j-channel</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!-- 显式声明：app 是真正起 servlet 容器的模块，不该靠通道传递过来 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <!--
          Boot 4 把 Flyway 的自动配置拆成了独立 artifact，而那条依赖跟着迁移脚本走，
          声明在 tools 模块（见那里的注释），这里靠依赖传递拿到。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
          只在本地开发时生效，不进产物，见 ADR-0005。
          用 provided 而不是 Gradle 那套 developmentOnly：Maven 不认这个 scope，
          每次构建都会打一条"项目格式不合法"的警告，未来版本还可能直接报错。
          provided 在编译与测试时可见、打包时被 spring-boot-maven-plugin 排除，正好是想要的。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-docker-compose</artifactId>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!--
          真实模型联调。默认不开，因为它烧 token、依赖外网、还要本机 docker compose 起来的库。
          回归基线是 mock 那批测试（ADR-0006、ADR-0008）：它们不烧钱也不会因为供应商抖动而红。
          用法：docker compose up -d && ./mvnw -Preal-model verify
        -->
        <profile>
            <id>real-model</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <!-- 只跑 IT：这一趟不看回归基线，只证明"真实供应商接得上" -->
                            <includes>
                                <include>**/*IT.java</include>
                            </includes>
                            <excludes>
                                <exclude>**/*Test.java</exclude>
                            </excludes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
          飞书 SDK 在 claw4j-channel 里是 optional，不会传递到这里。
          要飞书通道就必须显式声明，否则打出的产物不含飞书能力（也就不会白白带上它的传递依赖）。
          M2 做飞书长连接时启用：-Pchannel-feishu
        -->
        <profile>
            <id>channel-feishu</id>
            <dependencies>
                <dependency>
                    <groupId>com.larksuite.oapi</groupId>
                    <artifactId>oapi-sdk</artifactId>
                </dependency>
            </dependencies>
        </profile>
    </profiles>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <!-- 父 POM 用 BOM import 而不是继承 starter parent，repackage 必须显式绑定 -->
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
