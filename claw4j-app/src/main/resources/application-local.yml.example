# 本地开发配置模板。复制一份改名即生效：
#   cp application-local.yml.example application-local.yml
# 之后起本地只要一个参数：--spring.profiles.active=local
#
# 真正的 application-local.yml 不入库（会放真实 key 与真实的人）。
# 这一份负责：读 .env、用 compose 起 Postgres(pgvector)、跑迁移，并把技能 / 子 Agent /
# 知识库 / 长期记忆 / MCP 这几层打开。

spring:
  # Boot 不读 .env，这行把它当 properties 读进来。两个路径对应两种工作目录：
  # 从仓库根起（命令行）与从 claw4j-app 模块起（IDEA 默认）。
  config:
    import: optional:file:./.env[.properties],optional:file:../.env[.properties]

  # 让 Boot 顺手拉起 compose.yaml 里的 Postgres，退出时收掉。要从仓库根目录启动才找得到它。
  docker:
    compose:
      enabled: true
      file: compose.yaml
      lifecycle-management: start-and-stop

  # 库起来了才迁移（默认 profile 关着，免得没 Docker 时起不来）。
  # 脚本在各模块的 db/migration 下，按版本号自动排序，不用写 locations。
  # 改表结构 = 加一个号更大的新文件，不要改已提交的。
  flyway:
    enabled: true

logging:
  level:
    io.github.claw4j: DEBUG

claw4j:
  channel:
    http:
      # 准入白名单：空 = 谁都不能。本机 curl 要能进来，先把你自己（X-Claw4j-User 里那个名字）
      # 填进来；写 ["*"] 表示这条通道不设准入。
      users: []
    feishu:
      # 填提问那个人的 open_id。没填时通道照样连得上，但谁问都只收到"没有权限"
      # （日志里有带 sender= 的 WARN）。
      users: ["ou_xxxxxxxxxxxxxxxx"]

  # 谁能点审批按钮：飞书填 open_id，HTTP 填用户名。空 = 没人能批，请求会挂到过期。
  approval:
    approvers: []

  # ---- 链上跑的东西：短期记忆（会话）与长期记忆 ----
  # 键的含义见 application.yml 的 advisor: 段；这里只写本地会动到的几项。
  # 要验"换段 = 换对话"就把 reset.mode 改成 daily-and-idle；换模型改 context-window。
  advisor:
    session:
      schema: claw4j_session
      # 私聊边界。多人可及的部署必须改成 per-channel-peer（见 application.yml 那段注释）。
      dm-scope: main
      group-scope: per-group
      context-window: 65536
      reset:
        mode: none

    # ---- 长期记忆：跨会话记住"你是谁、你偏好什么"，模型自己决定记什么 ----
    # 放仓库外：这是本机这个人的数据，不是项目产物。写进去是明文 Markdown，每人一个子目录。
    # dream 是后台整理（合并重复、删过时的），默认开；关掉只是不整理，读写照旧。
    memory:
      directory: ${user.home}/.claw4j/memory
      dream: true

  # 知识库：本地有 pgvector 与 qwen key，所以打开。相对路径按启动目录解析，要从仓库根起。
  rag:
    enabled: true
    directory: examples/knowledge

  # 技能：目录里每份 SKILL.md 是一个技能。模型先看到名字与一句话，需要时再取正文。
  skills:
    directory: examples/skills

  # 子 Agent：目录里每份 *.md 是一个可派的对象，派活的工具叫 Task。
  subagents:
    directory: examples/subagents


  # ---- 业务示例插件（claw4j-example-sales）：导出 querySales ----
  # tool-filter 决定它提供哪些工具：排掉的从清单里整条消失，后面的 allow 也加不回来。
  example:
    sales:
      tool-filter:
        # include 非空则必须命中；exclude 命中即排除；条目支持 * 通配（按整串匹配）。
        # 两个都空 = 不筛，也就是默认的样子。
        include: []
        exclude: []

  # ---- MCP：一段配置 = 一条连接 = 一组外部工具 ----
  # transport 两种写法：stdio 起一个子进程（用它的 stdin/stdout 说协议），http 连一个已跑着的端点。
  # 相对路径按启动目录解析，所以要从仓库根起。子进程只继承 PATH；
  # 要别的变量写 inherit-env，要专用凭据写 env（值写句柄 secret:<名字>）。
  # 不接就整段注释掉：没有端点就没有工具，不影响启动。
  capability:
    mcp:
      # npx 起的 server 启动要约 36 秒，超过默认的 30 秒会超时（症状：
      # "Client failed to initialize by explicit API call"）。要用下面 npx 那两个，
      # 先解注释这两行，两个都要给。
      # request-timeout: 120s
      # initialization-timeout: 90s

      servers:
        # 仓库自带，只要 python3。demo_now 每次返回不同的 pid 与时间戳，用来验"结果来自新进程"。
        demo:
          command: python3
          args:
            - examples/mcp/demo_mcp_server.py

        # Java 版走 HTTP，不需要 command / args。启动顺序随意：本应用先起时这条连接记 DOWN，
        # 之后自动退避重连（15 秒起、封顶 10 分钟），server 一起来就 UP，不用重启本应用。
        # 另开一个终端在仓库根目录：java -jar claw4j-example-mcp-server/target/*.jar
        java-http:
          transport: http
          url: http://127.0.0.1:8082
          # 只留前两个工具（它一共导出三个）。排掉的从清单里消失，allow 也加不回来。
          # tool-filter:
          #   include: [runtimeSnapshot, cronNext]
          #   # 等价写法：exclude: [simulateSlowCall]；通配写 "runtime*"（整串匹配）

        # 把 gh 包成只读能力：列表、CI 状态、API 查询。要本机装了 gh 且已登录。
        github:
          command: python3
          args:
            - examples/mcp/gh_mcp_server.py

        # 读和写混装：mail_list_unread 是读，mail_send 有副作用。
        # 只想放读的，用 tool-filter.exclude 把写工具排掉。要本机装了 himalaya 且配好账户。
        mail:
          command: python3
          args:
            - examples/mcp/himalaya_mcp_server.py

        # ---- 六个生活域：都不需要 key，但**要出网** ----
        # 存在的理由不是"工具数量"，是让工具目录里有跟代码无关的能力：天气、剧集、菜谱、
        # 艺术品、汇率、颜色、身体健康。少了这一层，检索评测考的就只是"技术词撞没撞上"。
        #
        # 每个工具的真实可用性都实测过（2026-11-27）：下面这些公开接口在本机通，
        # 而 Wikipedia（超时）、Nominatim（超时）、Met Museum（410 已下线）、
        # Art Institute（403）、Google Books（502）、iTunes 的 movie/tvShow（返回 0 条）都不通，
        # 所以没有"百科""地点路线""电影""书"这几类。要加，先确认对方还活着。
        #
        # 评测上下文（ToolRetrievalExportTest）里另有一份同样的声明——它只加载自动配置、
        # 不读这份 yml。加 server 要两处都加，漏一处评测会报"60 秒内 MCP 工具没到位"。
        weather:
          command: python3
          args:
            - examples/mcp/weather_mcp_server.py
        media:
          command: python3
          args:
            - examples/mcp/media_mcp_server.py
        food:
          command: python3
          args:
            - examples/mcp/food_mcp_server.py
        culture:
          command: python3
          args:
            - examples/mcp/culture_mcp_server.py
        life:
          command: python3
          args:
            - examples/mcp/life_mcp_server.py
        # 这一条不联网，纯算术：BMI、每日热量、饮水量。
        health:
          command: python3
          args:
            - examples/mcp/health_mcp_server.py

        # ---- 别人写的两个：默认关着，因为要 Node 与出网 ----
        # 打开：去掉下面几行行首的 "# "，并把上面两行超时也解注释。
        # everything 是官方参考实现（零参数、零凭据）；deepwiki 是公开的 HTTP 端点（不起进程）。
        #
        # everything:
        #   command: npx
        #   args: ["-y", "@modelcontextprotocol/server-everything"]
        #   inherit-env: [PATH, HOME]   # npx 靠 PATH 找到自己、靠 HOME 放包缓存
        # deepwiki:
        #   transport: http
        #   url: https://mcp.deepwiki.com   # endpoint 不填就走 SDK 默认的 /mcp
        #   # 要连需要凭据的端点就解开下面两行。头里写句柄：secret:deepwiki_token 对应环境变量
        #   # DEEPWIKI_TOKEN，真值在每次请求时才换出来；裸写 "Bearer xxx" 启动就会被拒。
        #   # headers:
        #   #   Authorization: "Bearer secret:deepwiki_token"
