# 本地开发配置模板。复制为 application-local.yml 后生效：
#   cp application-local.yml.example application-local.yml
#
# 真正的 application-local.yml 已被 .gitignore 忽略 —— 它可能放真实 API key，
# 绝不能入库。这个文件是模板，随仓库走。

spring:
  # Boot 默认不读 .env（那是 docker compose 的约定），这行按 properties 解析进来。
  # 两个位置对应两种工作目录：仓库根目录（命令行）与 claw4j-app 模块（IDEA 默认）。
  config:
    import: optional:file:./.env[.properties],optional:file:../.env[.properties]

  # 让 Boot 自动拉起并回收 compose.yaml 里的 Postgres(pgvector)。
  # 工作目录要能找到 compose.yaml，也就是从仓库根目录启动。
  docker:
    compose:
      enabled: true
      file: compose.yaml
      lifecycle-management: start-and-stop

  # 库起来了才做迁移（默认 profile 里是关的，免得没 Docker 时启动失败）。
  # 迁移脚本在 claw4j-capability 的 classpath:db/migration 下，改 schema 是加一个新版本文件。
  flyway:
    enabled: true

logging:
  level:
    io.github.claw4j: DEBUG

claw4j:
  channel:
    feishu:
      # 谁能用飞书通道：把提问那个人的 open_id 填在这里。角色（可看哪些表、能做哪些动作）
      # 仍然只在 application.yml 里写一份，这里只补"人"——两处写同一份授权，早晚不一致。
      # 必须写在本文件而不是仓库那份 application.yml：open_id 是真实的人，不该入库。
      # 没填时通道照样连得上，但任何人提问都只会收到"没有权限"（日志里有带 sender=ou_... 的 WARN）。
      roles:
        read-only:
          users: ["ou_xxxxxxxxxxxxxxxx"]
