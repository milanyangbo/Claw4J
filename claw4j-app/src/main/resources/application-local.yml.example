# 本地开发配置模板。复制为 application-local.yml 后生效：
#   cp application-local.yml.example application-local.yml
#
# 真正的 application-local.yml 已被 .gitignore 忽略 —— 它可能放真实 API key，
# 绝不能入库。这个文件是模板，随仓库走。

spring:
  # .env 是 docker compose 的约定格式，Spring Boot 默认不读它。
  # 这行按 properties 解析进来（KEY=VALUE 两种格式兼容），
  # 于是根目录 .env 里的 DEEPSEEK_API_KEY 对应用也可见。
  config:
    import: optional:file:.env[.properties]

  # 让 Boot 自动拉起并回收 compose.yaml 里的 Postgres(pgvector) 与 Redis。
  # 工作目录要能找到 compose.yaml，也就是从仓库根目录启动。
  docker:
    compose:
      enabled: true
      file: compose.yaml
      lifecycle-management: start-and-stop

logging:
  level:
    io.github.claw4j: DEBUG
