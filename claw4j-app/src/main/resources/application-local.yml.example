# 本地开发配置模板。复制一份改名为 application-local.yml 即生效：
#   cp application-local.yml.example application-local.yml
#
# 真正的 application-local.yml 不入库（.gitignore）：它可能放真实 key、真实的人。
#
# 这一份替你做四件事：导入 .env、让 Boot 拉起 compose.yaml 里的 Postgres(pgvector) 并打开迁移、
# 打开知识库与技能。MCP 那一层也在这里——接哪几个 server 是"这台机器"的事，不是框架的默认值。

spring:
  # Boot 不读 .env（那是 docker compose 的约定），这行按 properties 解析进来。
  # 两个位置对应两种工作目录：仓库根目录（命令行）与 claw4j-app 模块（IDEA 默认）。
  config:
    import: optional:file:./.env[.properties],optional:file:../.env[.properties]

  # 让 Boot 拉起并回收 compose.yaml 里的 Postgres。工作目录要能找到 compose.yaml，
  # 也就是从仓库根目录启动。
  docker:
    compose:
      enabled: true
      file: compose.yaml
      lifecycle-management: start-and-stop

  # 库起来了才做迁移（默认 profile 里是关的，免得没 Docker 时启动失败）。
  # 迁移脚本散在各模块的 classpath:db/migration 下，Flyway 会扫遍并按版本号排序，不用写 locations。
  # 改 schema = 加一个版本号更大的新文件，不要回头改已提交的。
  flyway:
    enabled: true

logging:
  level:
    io.github.claw4j: DEBUG

claw4j:
  channel:
    http:
      # HTTP 通道的准入白名单（ADR-0030）：空 = 谁都不能。本机 curl 要能进来，就先把你自己
      # （也就是 X-Claw4j-User 里那个名字）填进来；整份写 ["*"] 表示这条通道不设准入。
      users: []
    feishu:
      # 谁能用飞书通道：把提问那个人的 open_id 填在这里。
      # 它只是一份准入白名单——角色、能读哪些表那一层随 ADR-0030 整块下线了。
      # 没填时通道照样连得上，但任何人提问都只收到"没有权限"（日志里有带 sender= 的 WARN）。
      users: ["ou_xxxxxxxxxxxxxxxx"]

  # 谁能点审批按钮：飞书那边写 open_id，HTTP 那边写用户名（X-Claw4j-User）。
  # 不写就是没人能批：待批请求会挂到过期，启动日志里有一条 WARN。
  approval:
    approvers: []

  # 知识库：默认关（别的部署没有 embedding 凭据、也没有 pgvector 那张表），本地两样都有。
  # 重排跟着默认值走（开），挂掉时只是不重排，不影响检索。
  # 相对路径按当前工作目录解析，所以要从仓库根目录起。
  rag:
    enabled: true
    directory: examples/knowledge

  # 技能：默认不配（别的部署没有这个目录，配了目录里没 SKILL.md 会启动失败）。
  # 这一层导出的是 Skill 工具：描述里只有名字与一句话，正文要按名字调一次才回来。
  skills:
    directory: examples/skills

  # ---- 业务示例插件（claw4j-example-sales）----
  # 默认就装着，导出 querySales。tool-filter 决定这个插件**提供哪些工具**：
  # 排掉之后，工具清单、权限登记、画像登记三处一起没有它——策略层的 allow 加不回来，
  # 因为过滤发生在"它变成工具"之前。
  example:
    sales:
      tool-filter:
        # include 非空则必须命中；exclude 命中即排除；条目支持 * 通配（按整串匹配）。
        # 两个都空 = 不筛，也就是默认的样子。
        include: []
        exclude: []

  # ---- MCP：一段配置 = 一条连接 = 一个能力来源 ----
  # stdio 起一个子进程用它的 stdin/stdout 说协议，http 连一个别人已经跑着的端点；
  # 差别只在 transport 一个键，连接生命周期与鉴权不用改。
  # 相对路径按**当前工作目录**解析（stdio 子进程继承宿主 CWD），所以从仓库根目录起才对。
  # 子进程的环境只有 PATH；需要 HOME 之类的变量就在那个 server 的 inherit-env 里写。
  # 要给子进程专用凭据就写 env，值是句柄 secret:<名字>（常量写 plain:<文本>），裸写会被拒并点名。
  # 不接 MCP 就把整段注释掉：没有端点就没有工具，不影响启动。
  capability:
    mcp:
      # npx 起的 server 每次启动约 36 秒（缓存热了也一样），而默认 request-timeout 是 30 秒——
      # 它会在 server 就绪前超时，症状是 "Client failed to initialize by explicit API call"。
      # 要打开下面注释着的那两个，先把这两行一起解注释，两个都得给。
      # request-timeout: 120s
      # initialization-timeout: 90s

      servers:
        # 仓库自带的三个，只要 python3，都在 examples/mcp/ 下。
        # demo_now 每次返回不同的 pid 与时间戳，"结果来自新起的进程"因此可判定。
        demo:
          command: python3
          args:
            - examples/mcp/demo_mcp_server.py

        # Java 版走 HTTP，不是要被 fork 的文件，所以没有 command / args。
        # 先起它，再起本应用（另开一个终端，在仓库根目录）：
        #   java -jar claw4j-example-mcp-server/target/claw4j-example-mcp-server-0.1.0-SNAPSHOT.jar
        # 反过来也能跑：本应用先起时这条连接记 DOWN，之后按 15 秒起、翻倍、封顶 10 分钟
        # 退避重连；server 起来后自动 UP，不用重启本应用。
        java-http:
          transport: http
          url: http://127.0.0.1:8082
          # 存在性过滤：排掉的工具不进清单、不进画像登记，allow 加不回来。
          # 它导出 runtimeSnapshot / cronNext / simulateSlowCall 三个，下面这条只留前两个。
          # tool-filter:
          #   include: [runtimeSnapshot, cronNext]
          #   # 等价写法：exclude: [simulateSlowCall]；通配写 "runtime*"（整串匹配）

        # 把 gh 包成只读能力：列表、CI 状态、API 查询。要本机装了 gh 且已登录。
        github:
          command: python3
          args:
            - examples/mcp/gh_mcp_server.py

        # 混装的那一个：mail_list_unread 是读，mail_send 有副作用。
        # 权限声明那一层（permission / tools）已经整块下线（ADR-0030 票 04）：这里只回答
        # "接谁、装哪些工具"。想只放读的那几个，用 tool-filter.exclude 把写工具排掉。
        # 要本机装了 himalaya 且配好账户。
        mail:
          command: python3
          args:
            - examples/mcp/himalaya_mcp_server.py

        # ---- 别人写的两个：默认关着，因为要 Node 与出网 ----
        # 打开方法：把下面 `# everything:` 到文件末尾的行首 "# " 去掉，再把上面两行超时也解注释。
        # everything = 官方参考实现：零参数、零凭据，工具名与返回都是确定的，整条按只读声明准确。
        # deepwiki  = 公开的 Streamable HTTP 端点：无需凭据、不起进程，工具都是"读某个仓库的文档"。
        #
        # everything:
        #   command: npx
        #   args: ["-y", "@modelcontextprotocol/server-everything"]
        #   inherit-env: [PATH, HOME]   # npx 靠 PATH 找到自己、靠 HOME 放包缓存
        # deepwiki:
        #   transport: http
        #   url: https://mcp.deepwiki.com   # endpoint 不填就走 SDK 默认的 /mcp
        #   # 要连需要凭据的端点就解开下面两行。头里写句柄：secret:deepwiki_token 对应环境变量
        #   # DEEPWIKI_TOKEN，真值在每次请求时才换出来；裸写 "Bearer xxx" 启动就会被拒。
        #   # headers:
        #   #   Authorization: "Bearer secret:deepwiki_token"
