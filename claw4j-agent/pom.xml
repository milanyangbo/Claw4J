<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.claw4j</groupId>
        <artifactId>claw4j</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>claw4j-agent</artifactId>
    <name>Claw4J :: Agent</name>
    <description>ChatClient 装配、Advisor 链、Session 与工具鉴权，见 ADR-0007</description>

    <dependencies>
        <dependency>
            <groupId>io.github.claw4j</groupId>
            <artifactId>claw4j-domain</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--
          工具层（ADR-0003 第一层）。M0 时这条边没接上，工具无处可挂。
          装配只依赖 ToolCallbackProvider 这个 Spring AI 接口，不点名具体工具类，
          所以加工具是加一个 bean，改不到这里的装配代码。
        -->
        <dependency>
            <groupId>io.github.claw4j</groupId>
            <artifactId>claw4j-tools</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-client-chat</artifactId>
        </dependency>
        <!--
          主模型供应商（ADR-0006）。故意用纯模型包而不是 starter：
          starter 带来的自动配置条件是 spring.ai.model.chat=deepseek 且 matchIfMissing=true，
          跟 api key 无关，缺 key 时照样激活并抛异常。这里由 ModelConfiguration 自己按
          key 有无装配（ADR-0006），不需要厂商自动配置参与。
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-deepseek</artifactId>
        </dependency>
        <!--
          备用供应商（ADR-0006）：通义没有官方适配器，走它自己的 OpenAI 兼容端点。
          同样只用纯模型包，装配权在我们手里。
          代价要记账：它把 openai-java-core 与 okhttp 带进来了 —— 不是我们想引第二套 HTTP 客户端，
          而是厂商 SDK 自带；DeepSeek 一侧仍用 JDK HttpClient，两侧互不影响。
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-openai</artifactId>
        </dependency>
        <!--
          会话记忆（ADR-0005，M1-06）。注意 groupId 是 org.springaicommunity 而不是
          org.springframework.ai：spring-ai-session 是 spring-ai-community 的独立项目，
          在 Spring AI 官方的 2.0.2 BOM 里查不到它。版本由根 pom import 的
          spring-ai-session-bom 管着。
          它自带两个自动配置：SessionRepository（JDBC）与 SessionService。
          SessionRepository 那个会被本模块的 SessionMemoryConfiguration 顶掉
          ——它默认拿主 DataSource，会话表会落到 public，而我们要的是独立 schema。
        -->
        <dependency>
            <groupId>org.springaicommunity</groupId>
            <artifactId>spring-ai-starter-session-jdbc</artifactId>
        </dependency>
        <!--
          显式声明而不是靠 tools 传递：会话存储（M1-06）在这里直接用了
          DataSource / JdbcTemplate / Hikari，用到什么就声明什么，
          免得哪天 tools 不再需要 JDBC 时这里静悄悄跟着变。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
          Text-to-SQL 的端到端断言要在真库上跑（05 号票）：循环行为用替身测，
          "算出来的数对不对"只能对着真库说。于是 agent 的测试也要能起一次性 Postgres。
          与 tools 模块里那套是同一个约定：镜像可用才跑，CI 上是 -Dclaw4j.dbTests=required。
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
