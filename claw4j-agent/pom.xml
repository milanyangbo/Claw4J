<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.claw4j</groupId>
        <artifactId>claw4j</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>claw4j-agent</artifactId>
    <name>Claw4J :: Agent</name>
    <description>ChatClient 装配、Advisor 链、Session 与工具鉴权，见 ADR-0007</description>

    <dependencies>
        <dependency>
            <groupId>io.github.claw4j</groupId>
            <artifactId>claw4j-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--
          工具层（ADR-0003 第一层）。M0 时这条边没接上，工具无处可挂。
          装配只依赖 ToolCallbackProvider 这个 Spring AI 接口，不点名具体工具类，
          所以加工具是加一个 bean，改不到这里的装配代码。
        -->
        <dependency>
            <groupId>io.github.claw4j</groupId>
            <artifactId>claw4j-capability</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--
          Subagent 定义文件的解析（M2-05）：front matter（name / description / tools /
          disallowedTools）与正文的分拆用这里的 MarkdownParser，与 Skill 那一层
          读 SKILL.md 是同一个解析器——两份文件格式一致，"专职 Agent 与做法"
          才是同一种东西。只取解析器这一个用法，不引它的 Task 执行器：
          那个执行器用的是它自己的 ChatClient 装配（拿不到本项目的调用预算与鉴权 Advisor）。
          排除 flexmark 的理由同 claw4j-capability。
        -->
        <dependency>
            <groupId>org.springaicommunity</groupId>
            <artifactId>spring-ai-agent-utils</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>com.vladsch.flexmark</groupId>
                    <artifactId>flexmark-html2md-converter</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-client-chat</artifactId>
        </dependency>
        <!--
          知识库的编排（P10）：`RetrievalAugmentationAdvisor` + 三个槽位接口
          （`DocumentRetriever` / `DocumentJoiner` / `DocumentPostProcessor`）。

          这个模块是"纯编排"，不带任何存储实现——正因为如此，我们才在里面补
          `KeywordDocumentRetriever`（全文那一路）与 `RerankDocumentPostProcessor`（重排）：
          官方给了接口没给实现，不是我们绕开它自己造 API。
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-rag</artifactId>
        </dependency>
        <!--
          语义缓存（M3-05）：用框架的实现，不再自己写存储。
          `spring-ai-redis-semantic-cache` 提供 `SemanticCacheAdvisor` 与 `DefaultSemanticCache`，
          缓存落 Redis Stack（RediSearch + RedisJSON）。它把 jedis 与 `spring-ai-redis-store`
          一起带进来，两个都是运行时真的要用——不要 exclude。
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-redis-semantic-cache</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-redis-store</artifactId>
        </dependency>
        <!--
          知识库（P10）：检索与存储都用框架的，不再自己拼 SQL。
          `PgVectorStore` 自带建表（vector_store）、向量写入与相似度检索；
          切块用 `spring-ai-commons` 里的 `TokenTextSplitter`（已在传递依赖里）。
          维度由装配时传进去的 dimensions 决定，与本项目 claw4j.model.embedding 一致。
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-pgvector-store</artifactId>
        </dependency>
        <!--
          工具检索（M3-06）：工具多到塞不进提示词时，让模型先找工具再调。
          刻意不用 starter：`spring-ai-starter-tool-search-advisor` 的自动配置会往
          ChatClient 里塞它自己的工具循环，跟我们按预算建的那个并存——两个循环里
          只有一个真的在用，另一个的预算与鉴权落点全是摆设。装配由 ToolSearch 自己决定。
          这个 jar 顺带带进 `spring-ai-tool-search-tool`（ToolIndex / ToolSearchTool /
          三种索引实现），Lucene 与 vector-store 在那边都是 optional，所以这里只有正则实现可用。
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-tool-search-advisor</artifactId>
        </dependency>
        <!--
          主模型供应商（ADR-0006）。故意用纯模型包而不是 starter：
          starter 带来的自动配置条件是 spring.ai.model.chat=deepseek 且 matchIfMissing=true，
          跟 api key 无关，缺 key 时照样激活并抛异常。这里由 ModelConfiguration 自己按
          key 有无装配（ADR-0006），不需要厂商自动配置参与。
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-deepseek</artifactId>
        </dependency>
        <!--
          备用供应商（ADR-0006）：通义没有官方适配器，走它自己的 OpenAI 兼容端点。
          同样只用纯模型包，装配权在我们手里。
          代价要记账：它把 openai-java-core 与 okhttp 带进来了 —— 不是我们想引第二套 HTTP 客户端，
          而是厂商 SDK 自带；DeepSeek 一侧仍用 JDK HttpClient，两侧互不影响。
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-openai</artifactId>
        </dependency>
        <!--
          会话记忆（ADR-0005，M1-06）。注意 groupId 是 org.springaicommunity 而不是
          org.springframework.ai：spring-ai-session 是 spring-ai-community 的独立项目，
          在 Spring AI 官方的 2.0.2 BOM 里查不到它。版本由根 pom import 的
          spring-ai-session-bom 管着。
          它自带两个自动配置：SessionRepository（JDBC）与 SessionService。
          SessionRepository 那个会被本模块的 SessionMemoryConfiguration 顶掉
          ——它默认拿主 DataSource，会话表会落到 public，而我们要的是独立 schema。
        -->
        <dependency>
            <groupId>org.springaicommunity</groupId>
            <artifactId>spring-ai-starter-session-jdbc</artifactId>
        </dependency>
        <!--
          显式声明而不是靠 tools 传递：会话存储（M1-06）在这里直接用了
          DataSource / JdbcTemplate / Hikari，用到什么就声明什么，
          免得哪天 tools 不再需要 JDBC 时这里静悄悄跟着变。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <!--
          本模块的 DDL 在 src/main/resources/db/migration（V3 会话表、V4/V5 语义缓存表），
          这三张表只有本模块的 agent.session / agent.cache 在读，所以迁移与依赖都归这里
          （M6-04：原先它们在 claw4j-capability，那个模块一条 JDBC 都不碰）。
          版本号接着示例插件的 V1/V2 往下排，全局唯一；Flyway 按版本号排序、跨 jar 合并不受影响，
          所以文件放在哪个 jar 里不影响执行顺序。

          三条缺一不可：
          - flyway-core：迁移引擎本身。
          - flyway-database-postgresql：Flyway 10+ 把各数据库的支持拆成独立 artifact。
          - spring-boot-flyway：Boot 4 把自动配置也拆了出去。只放 flyway-core 时
            spring.flyway.enabled=true 会**静默不生效**——启动日志一个字不提、表一直不建，
            而业务侧报的是"连不上库"，根因在迁移没跑，看的人只会去查网络
            （07 号票第一次真实联调就是这么挂的，见 docs/design/pitfalls.md 第三条）。
        -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!--
          trace 导出（P14）。**版本由根 pom 的 opentelemetry-bom 管**，这里不写 <version>。

          为什么不在这一层写版本：只给直接依赖钉 1.35.0 压不住传递依赖（sdk-logs、
          exporter-otlp-common、exporter-sender-okhttp、sdk-extension-autoconfigure-spi
          仍按 Boot BOM 的 1.62.0 解析），而 1.62.0 的 jar 本地一个都没有，离线构建直接红。
          整份 BOM 只能放在根 pom（app 也要用到这两个构件，模块内的管理不往下传）。

          两个 jar 都要显式声明：
          - opentelemetry-sdk：provider / sampler / batch processor。
          - opentelemetry-exporter-otlp：OTLP 那一个。它的运行时依赖只带
            `exporter-sender-okhttp`（HTTP），没有 gRPC sender——所以只能走 HTTP，
            见 OtelRunTracer 的类注释。
        -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-sdk</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
          Text-to-SQL 的端到端断言要在真库上跑（05 号票）：循环行为用替身测，
          "算出来的数对不对"只能对着真库说。于是 agent 的测试也要能起一次性 Postgres。
          与 claw4j-capability 里那套是同一个约定：镜像可用才跑，CI 上是 -Dclaw4j.dbTests=required。
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- flyway-core 原先只在这里以 test 身份出现（测试里手跑迁移）。
             现在它随 DDL 一起提成了编译期依赖，见上面那段注释，所以这条不再需要。 -->
    </dependencies>
</project>
