# 构建产物
target/
build/
*.class

# IDE
.idea/
*.iml
.DS_Store

# 1.x 运行时在工作目录生成的落盘文件
vector_store.json
scheduled_tasks.json

# 本地环境变量
.env
*.local

# 工作日志与本地工具状态：是过程记录，不是项目产物
.workbuddy/

# 本地配置覆盖：可能放真实 API key，绝不能入库
application-local.yml
application-local.yaml

# RAG 评测的产物与本地环境（gold.yaml / run_ragas.py / baseline.json 是源码，入库）
eval/rag/reports/*
!eval/rag/reports/.gitkeep
eval/rag/.venv/
eval/rag/__pycache__/

# Python 示例跑一次就会生成，不是源码
__pycache__/
*.pyc

# 验收现场留下的原始日志：本地证据，几百 KB 的 DEBUG，不入库
# （同目录的 README、SSE 帧、覆盖配置、超长人设都入库，是可以对着看的证据）
docs/acceptance/**/*.log

# 工具评测（票 12 检索层 / 票 17 选择层）：与 eval/rag 同一条规矩——基线入库，产物不入库。
# 两层各自的目录见 eval/tools/README.md。
eval/tools/retrieval/reports/*
!eval/tools/retrieval/reports/.gitkeep
# L2 选择层评测：题库与 README 入库，跑出来的逐题结果不入库。
eval/tools/retrieval/.venv/
eval/tools/retrieval/__pycache__/

# 选择层评测（票 17）：BFCL 自己的 venv / 临时目录 / 原始结果 / 排行榜 csv。
# 入库的只有 run.sh、boot.py、patch/、baseline.json——产物与标准分开。
eval/tools/bfcl/.venv/
eval/tools/bfcl/tmpdir/
eval/tools/bfcl/result/
eval/tools/bfcl/score/
# 跑数留痕：旧逐题结果挪到这里才不会被 BFCL 的缓存跳过，判据与数字不入库。
eval/tools/bfcl/stale-*/
eval/tools/bfcl/smoke/
eval/tools/bfcl/.file_locks/
eval/tools/bfcl/reports/*
!eval/tools/bfcl/reports/.gitkeep
eval/tools/bfcl/__pycache__/
eval/tools/bfcl/patch/__pycache__/

# 真实链路评测（票 28）：问句清单与脚本入库，跑出来的候选与逐题结果不入库。
# `candidates.json` 是导出产物（换个配置就换一份），`results.jsonl` 是模型输出——都是产物。
eval/tools/live/candidates.json
eval/tools/live/results.jsonl
eval/tools/live/reports/*
!eval/tools/live/reports/.gitkeep
eval/tools/live/__pycache__/
