<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.claw4j</groupId>
        <artifactId>claw4j</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>claw4j-domain</artifactId>
    <name>Claw4J :: Domain</name>
    <description>领域模型。不依赖 Spring、Spring AI 或任何通道 SDK，见 ADR-0004</description>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              ArchUnit 拦的是"源码里 import 了框架"，这条拦的是"POM 里声明了框架依赖"。
              两者缺一不可：前者管不住有人在 domain 里 import 一个没用到的 Spring 类型
              （编译不过所以其实也拦得住），后者管不住有人先把依赖加进来、再慢慢写代码。
              放在 validate 阶段，加错依赖当场就红，不用等到测试阶段。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>domain-must-stay-framework-free</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <excludes>
                                        <exclude>org.springframework</exclude>
                                        <exclude>org.springframework.ai</exclude>
                                        <exclude>org.springaicommunity</exclude>
                                        <exclude>com.larksuite.oapi</exclude>
                                        <exclude>io.micrometer</exclude>
                                        <exclude>io.projectreactor</exclude>
                                    </excludes>
                                    <message>
                                        domain 模块不得引入 Spring / Spring AI / 厂商 SDK / 响应式库。
                                        它是唯一被承诺"能脱离框架独立复用"的模块，见 ADR-0004 与 ADR-0010。
                                        需要框架能力就把它放到 agent 或 channel，由 app 接线。
                                    </message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
