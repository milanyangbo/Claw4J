#!/bin/sh
#
# 提交前的最后一道闸：只跑架构规则，秒级返回。
# 完整测试交给 CI——本地跑全量会把"提交"这个动作变得没人愿意做。
#
# 启用：git config core.hooksPath .githooks
# 跳过（紧急情况）：git commit --no-verify
#
# 为什么只跑架构规则：框架越界、模块依赖方向、Advisor 双实现这几类问题
# 一旦进了主分支就会以"能编译能跑"的状态长期存在，越晚发现越贵。
# 而它们恰好都不需要起容器、不需要网络，跑得动。
set -e

# 只改了文档或 legacy 就直接放行
staged=$(git diff --cached --name-only --diff-filter=ACM)
if ! echo "$staged" | grep -qE '^claw4j-.+\.(java|xml)$'; then
    exit 0
fi

exec ./mvnw -B -ntp -pl claw4j-domain,claw4j-agent,claw4j-channel,claw4j-tools test \
    -Dtest='*ArchitectureTest' \
    -Dsurefire.failIfNoSpecifiedTests=false
