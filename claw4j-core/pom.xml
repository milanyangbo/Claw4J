<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.claw4j</groupId>
        <artifactId>claw4j</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>claw4j-core</artifactId>
    <name>Claw4J :: Core</name>
    <description>框架的契约与不变量：domain（端口、Principal、权限登记表）+ channel.spi（通道契约）
        + channel.kernel（入站编排）。不依赖 Spring、不依赖任何 IM SDK，见 ADR-0010 / ADR-0015</description>

    <!--
      这个模块的全部意义在下面这段 dependencies 里：只有 slf4j。

      它装的是"所有别的模块都朝它依赖"的那一层：domain.port 是通道与 agent 之间的接缝，
      channel.spi 是通道实现要满足的契约，channel.kernel 是每个通道都要写一遍的入站四件事。
      飞书 SDK 在 claw4j-channel 里（那个模块依赖本模块），所以第三方接 Telegram 时
      依赖本模块就够了，classpath 里不会出现 com.larksuite.oapi。

      这条边界不是靠自觉：模块依赖方向写反就编译不过，而"有人在 pom 里加了 Spring"
      由下面 validate 阶段的 enforcer 当场拦下——两件事得分开守，因为前者管 import，
      后者管声明。
    -->
    <dependencies>
        <!-- 编排层要记日志；版本由 spring-boot-dependencies 管。
             这是本模块唯一一条编译期依赖——domain 里连它都没有（见 DomainBoundaryTest）。 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!--
          P16：插件版本契约要读"当前核心是哪个版本"，而清单里没有 Implementation-Version、
          META-INF/maven/.../pom.properties 又只存在于 jar 里（target/classes 下没有，
          于是开发态永远读不到）。所以自己生成一份，两种形态都在。

          过滤**必须按 includes 收窄到这一个文件**：src/main/resources 里躺着 Flyway 的
          db/migration/V*.sql，整个目录一起过滤会把 SQL 里出现的 ${ 替换成空串，
          而那是一次"看起来迁移过了"的静默损坏。
        -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>META-INF/claw4j-core.properties</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>META-INF/claw4j-core.properties</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <!--
              ArchUnit 拦的是"源码里 import 了框架"，这条拦的是"POM 里声明了框架依赖"。
              两者缺一不可：前者管不住有人先把依赖加进来、再慢慢写代码。
              放在 validate 阶段，加错依赖当场就红，不用等到测试阶段。

              这条规则从 claw4j-domain 搬过来（ADR-0015 把那个模块并进了本模块）：
              domain 与 channel.kernel 本来就是同一种东西——零框架的契约与不变量，
              现在它们在一个 jar 里，就只需要一条规则守着。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>core-must-stay-framework-free</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <excludes>
                                        <exclude>org.springframework</exclude>
                                        <exclude>org.springframework.ai</exclude>
                                        <exclude>org.springaicommunity</exclude>
                                        <exclude>com.larksuite.oapi</exclude>
                                        <exclude>io.micrometer</exclude>
                                        <exclude>io.projectreactor</exclude>
                                    </excludes>
                                    <message>
                                        claw4j-core 不得引入 Spring / Spring AI / 厂商 SDK / 响应式库。
                                        它是唯一被承诺"能脱离框架独立复用"的模块，见 ADR-0004、ADR-0010、ADR-0015。
                                        需要框架能力就把它放到 agent / channel / capability，由 app 接线。
                                    </message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
