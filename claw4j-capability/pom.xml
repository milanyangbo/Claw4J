<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.claw4j</groupId>
        <artifactId>claw4j</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>claw4j-capability</artifactId>
    <name>Claw4J :: Tools</name>
    <description>Java 层工具与 MCP 工具声明，能力三层中的第一层与第二层，见 ADR-0003</description>

    <dependencies>
        <dependency>
            <groupId>io.github.claw4j</groupId>
            <artifactId>claw4j-domain</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-client-chat</artifactId>
        </dependency>
        <!-- 能力三层里的第二层：MCP（ADR-0003）。坐标是从 spring-ai-bom:2.0.2 里
             逐条核对过的（starter-mcp-client / spring-ai-mcp / spring-ai-mcp-annotations
             都在 BOM 的 dependencyManagement 里），不是照文档抄的——
             M1-06 在 groupId 上栽过一次。它传递引 mcp-core（MCP Java SDK 2.1.0）与
             mcp-json-jackson3；spring-webflux / spring-webmvc 在链路里是 optional，不会带进来。

             为什么 client 与 server 两侧都用这一条：本票的 MCP server 是 Java 自实现的
             进程内 stdio server（测试替身兼演示），server 侧用到的
             StdioServerTransportProvider 与 McpServer 来自传递引的 mcp-core，
             @McpTool 扫描来自 spring-ai-mcp-annotations，都不需要再引 server starter。 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-client</artifactId>
        </dependency>
        <!-- 能力三层里的第三层：Script Package（ADR-0003）。
             要的是它那条执行接缝——ExecBackend / ExecSpec / ExecResult 在 -common 里，
             LocalExecBackend（带 workingDirectory 与 cleanEnvironment）在本 artifact 里。
             换沙箱等于换一个 ExecBackend 实现，调用方一行不动，这是这条边界唯一可测的地方。

             排除 flexmark：它是这个包里 Skills 那部分做 Markdown 转换用的，
             本项目只用执行那一层，不引就别带上（带上就是一个没人用得上的传递依赖）。
             版本由根 POM 的 dependencyManagement 管（0.13.0），不在这里写死。 -->
        <dependency>
            <groupId>org.springaicommunity</groupId>
            <artifactId>spring-ai-agent-utils</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>com.vladsch.flexmark</groupId>
                    <artifactId>flexmark-html2md-converter</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- 自动配置注解（@AutoConfiguration / @ConditionalOnMissingBean）来自这里。
             工具层用自动配置把自己交给容器，调用方就不用点名工具类。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!-- 业务数据查询走 JDBC，不引 JPA：这套库是给 Text-to-SQL 用的，
             模型生成的是 SQL，不是实体关系映射。JdbcClient 是 Spring 自带的薄封装。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- 迁移落在本模块：schema 与种子是"业务数据"的一部分，跟着业务查询走，
             app 通过依赖传递拿到，启动时的自动迁移扫的是同一份 classpath:db/migration。
             Flyway 10+ 把各数据库的驱动拆成了独立 artifact，Postgres 要显式引。 -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <!--
          Boot 4 把 Flyway 的自动配置拆成了独立 artifact：flyway-core 在 classpath 上
          并不足以让 spring.flyway.enabled 生效，FlywayAutoConfiguration 在 spring-boot-flyway 里。
          少了这一条的表现是本项目至今最阴的一种：配置写着 enabled=true、启动日志一个字不提、
          表一直不建，而业务侧报的是"连不上库"——根因在迁移没跑，看的人只会去查网络。
          （07 号票第一次真实联调就是这么挂的。）
          它跟迁移脚本放在一起，是因为"启动即迁移"这件事只有这两个东西同时在才成立。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>
        <!-- 驱动只要运行时，编译期不该有人 import 它 -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 每个测试用例面对的是一次性 Postgres，不是 compose 里那个会攒脏数据的常驻库 -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
