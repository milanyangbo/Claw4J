<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.claw4j</groupId>
    <artifactId>claw4j</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Claw4J</name>
    <description>企业 IM 上的 Agent 平台，基于 Spring AI 2.x 重建（见 docs/adr/）</description>

    <modules>
        <module>claw4j-domain</module>
        <module>claw4j-agent</module>
        <module>claw4j-channel</module>
        <module>claw4j-tools</module>
        <module>claw4j-app</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- 版本基线，见 ADR-0001。改动这四个版本等于改架构决策，要在 ADR 里留痕 -->
        <spring-boot.version>4.1.2</spring-boot.version>
        <spring-ai.version>2.0.2</spring-ai.version>
        <spring-ai-agent-utils.version>0.13.0</spring-ai-agent-utils.version>
        <spring-ai-session.version>0.10.0</spring-ai-session.version>

        <lark-oapi.version>2.8.7</lark-oapi.version>
        <archunit.version>1.5.1</archunit.version>
        <maven-enforcer.version>3.6.3</maven-enforcer.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 事件溯源会话记忆，2.1 起计划接替内置 ChatMemory，见 ADR-0005 -->
            <dependency>
                <groupId>org.springaicommunity</groupId>
                <artifactId>spring-ai-session-bom</artifactId>
                <version>${spring-ai-session.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Skills / Todo / Subagent / AskUserQuestion，见 ADR-0003 -->
            <dependency>
                <groupId>org.springaicommunity</groupId>
                <artifactId>spring-ai-agent-utils</artifactId>
                <version>${spring-ai-agent-utils.version}</version>
            </dependency>
            <!-- 飞书长连接通道，只在 claw4j-channel 里以 optional 引入，见 ADR-0009 -->
            <dependency>
                <groupId>com.larksuite.oapi</groupId>
                <artifactId>oapi-sdk</artifactId>
                <version>${lark-oapi.version}</version>
            </dependency>
            <!-- 架构边界的机器校验，见 ADR-0010 -->
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>${maven-enforcer.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!--
              版本基线。JDK 与 Maven 版本不对时，报的错经常指向完全无关的地方
              （比如"找不到某个 plugin goal"），所以这里先拦一道，给出明确信息。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>baseline</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,)</version>
                                    <message>JDK 21 起步（ADR-0001）</message>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9.0,)</version>
                                    <message>Maven 3.9.0 起步；仓库自带 wrapper，用 ./mvnw 就不用自己装</message>
                                </requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
