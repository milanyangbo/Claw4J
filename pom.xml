<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.claw4j</groupId>
    <artifactId>claw4j</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Claw4J</name>
    <description>企业 IM 上的 Agent 平台，基于 Spring AI 2.x 重建（见 docs/adr/）</description>

    <modules>
        <module>claw4j-domain</module>
        <module>claw4j-agent</module>
        <module>claw4j-channel</module>
        <module>claw4j-capability</module>
        <module>claw4j-app</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- 版本基线，见 ADR-0001。改动这四个版本等于改架构决策，要在 ADR 里留痕 -->
        <spring-boot.version>4.1.2</spring-boot.version>
        <spring-ai.version>2.0.2</spring-ai.version>
        <spring-ai-agent-utils.version>0.13.0</spring-ai-agent-utils.version>
        <spring-ai-session.version>0.10.0</spring-ai-session.version>

        <!-- Boot 4.1.2 的 BOM 指向 testcontainers 2.0.5，但当前镜像源里这个 artifactId
             只同步到 1.21.4，2.x 拉不下来（构建会红）。这里覆盖成 1.21.4，等源同步后
             删掉这一行就回到 BOM 管理。换版本时记得 2.x 改过包名
             （org.testcontainers.containers.* → org.testcontainers.<module>.*）。 -->
        <testcontainers.version>1.21.4</testcontainers.version>
        <lark-oapi.version>2.8.7</lark-oapi.version>
        <archunit.version>1.5.1</archunit.version>
        <maven-enforcer.version>3.6.3</maven-enforcer.version>
        <!-- 显式写出来是因为下面要为它加配置：本项目不继承 spring-boot parent，
             插件版本在 pluginManagement 里没有版本就解析不出来（构建直接失败）。
             这个版本就是此前一直跑的那个（构建日志里那行 maven-surefire-plugin:3.5.4）。 -->
        <maven-surefire.version>3.5.4</maven-surefire.version>
        <!-- 覆盖率红线：docs/agents/testing.md 第二节的第三条界限。0.8.13 支持 JDK 21 的 class 文件版本。
             换版本先确认它能读 21 的字节码，否则报的是"无法插桩"，看起来像测试全挂。 -->
        <jacoco.version>0.8.13</jacoco.version>
        <jacoco.line.minimum>0.60</jacoco.line.minimum>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 放在 Boot BOM 之后，才能盖掉里面 import 的 testcontainers 版本：
                 嵌套 import 的属性不会被外层 properties 覆盖，只能靠后声明的 BOM 赢。
                 core 还得单独钉一次：BOM 管得住 postgresql / junit-jupiter 这些模块，
                 但 junit-jupiter 传递引 core 时拿到的仍是 Boot BOM 里的 2.0.5，
                 于是 1.21.4 的扩展配上 2.0.5 的 core，跑起来就是混着来的。 -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers</artifactId>
                <version>${testcontainers.version}</version>
            </dependency>
            <!-- 事件溯源会话记忆，2.1 起计划接替内置 ChatMemory，见 ADR-0005 -->
            <dependency>
                <groupId>org.springaicommunity</groupId>
                <artifactId>spring-ai-session-bom</artifactId>
                <version>${spring-ai-session.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Skills / Todo / Subagent / AskUserQuestion，见 ADR-0003 -->
            <dependency>
                <groupId>org.springaicommunity</groupId>
                <artifactId>spring-ai-agent-utils</artifactId>
                <version>${spring-ai-agent-utils.version}</version>
            </dependency>
            <!-- 飞书长连接通道，只在 claw4j-channel 里以 optional 引入，见 ADR-0009 -->
            <dependency>
                <groupId>com.larksuite.oapi</groupId>
                <artifactId>oapi-sdk</artifactId>
                <version>${lark-oapi.version}</version>
            </dependency>
            <!-- 架构边界的机器校验，见 ADR-0010 -->
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>${maven-enforcer.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire.version}</version>
                    <!--
                      real-cli 这一组默认不跑（M2-07）。

                      为什么是"排除"而不是在测试里 assume：assume 出来的结果是 skipped，
                      而跳过的绿和通过的绿在报表里长得一模一样——这条仓库有条闸专门
                      把 skipped 判成失败（scripts/assert-no-skipped-tests.sh），
                      用 assume 就等于给这条闸开一个口子。排除是"这次没选它"，
                      报表里根本不会出现，也就没有"它到底跑了没有"这个疑问。

                      这一组里跑的是真的外部 CLI：起 Python 子进程、包 gh 与 himalaya。
                      它们依赖本机装了什么，不属于回归基线（票面：真实调用不进 CI）。

                      本机想跑：./mvnw test -DexcludedGroups= -Dgroups=real-cli
                    -->
                    <configuration>
                        <!-- 一个不存在的组名：profile 里要把它顶掉，而"空"在 surefire 里
                             会被当成没设置（于是继承这一份，照样排除）。 -->
                        <excludedGroups>real-cli</excludedGroups>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!--
              版本基线。JDK 与 Maven 版本不对时，报的错经常指向完全无关的地方
              （比如"找不到某个 plugin goal"），所以这里先拦一道，给出明确信息。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>baseline</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,)</version>
                                    <message>JDK 21 起步（ADR-0001）</message>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9.0,)</version>
                                    <message>Maven 3.9.0 起步；仓库自带 wrapper，用 ./mvnw 就不用自己装</message>
                                </requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
              行覆盖率红线，见 docs/agents/testing.md 第二节：文件数与方法数是上限，覆盖率是下限。
              上限靠数文件，下限只能靠工具——少写几份很容易，少写到漏掉整块功能没人看得出来。

              check 绑在 verify 而不是 test：单元测试阶段还没有 exec 数据，
              绑 test 会永远读到"没有覆盖率"然后按 0 判红。
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <configuration>
                    <!--
                      不算进覆盖率的分母：
                      - package-info：纯声明
                      - *Application：启动类，方法体只是把控制权交给框架
                      - *Configuration / *Properties：装配与配置绑定，没有分支；
                        它们接得对不对由整机端到端那一份证明，不由"逐行覆盖"证明
                      排除的是"测它等于复述框架注解"的那部分，不是难测的那部分。
                      写在插件层而不是 check 的执行里：report 与 check 必须看同一批类，
                      否则 csv 上的数字和闸门的判断会对不上（两份报告两套分母，谁也说不清哪个算数）。
                    -->
                    <excludes>
                        <exclude>**/package-info.class</exclude>
                        <exclude>**/*Application.class</exclude>
                        <exclude>**/*Configuration.class</exclude>
                        <exclude>**/*Properties.class</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check-line-coverage</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.line.minimum}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          真实外部 CLI 那一组：默认不跑，加 -Preal-cli 才跑。

          为什么不直接用 -DexcludedGroups= 顶掉：surefire 对空值的处理是"当作没设置"，
          于是继承下来的排除照样生效，命令行顶不掉它（-Dgroups=real-cli 也一样：
          groups 与 excludedGroups 同时给了同一组，结果是这一组被排除）。
          用 profile 把两个参数一起换掉才是确定的。

              ./mvnw -Preal-cli -pl claw4j-capability test -Dtest=RealCliMcpEndToEndTest
        -->
        <profile>
            <id>real-cli</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <groups>real-cli</groups>
                            <excludedGroups>no-such-group</excludedGroups>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
