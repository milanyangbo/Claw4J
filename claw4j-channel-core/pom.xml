<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.claw4j</groupId>
        <artifactId>claw4j</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>claw4j-channel-core</artifactId>
    <name>Claw4J :: Channel :: Core</name>
    <description>通道契约与入站编排：不依赖任何 IM SDK，接一个新通道只需要这一个模块</description>

    <!--
      这个模块的全部意义在下面这段 dependencies 里：只有 domain 与 slf4j。

      飞书 SDK 在 claw4j-channel 里（那个模块依赖本模块）。所以第三方接 Telegram 时，
      依赖本模块就够了——他能拿到 ChatChannel 契约与入站编排，而 classpath 里
      不会出现 com.larksuite.oapi。这条边界不是靠自觉：模块依赖方向写反就编译不过。
    -->
    <dependencies>
        <dependency>
            <groupId>io.github.claw4j</groupId>
            <artifactId>claw4j-domain</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- 编排层要记日志；版本由 spring-boot-dependencies 管。 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
