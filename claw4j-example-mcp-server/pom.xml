<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.claw4j</groupId>
        <artifactId>claw4j</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>claw4j-example-mcp-server</artifactId>
    <name>Claw4J :: Example :: MCP Server</name>
    <description>一个独立运行的 Java MCP server（Streamable HTTP，/mcp），与 examples/mcp 下的 Python 版平级</description>

    <dependencies>
        <!--
          这份 pom 里**没有任何 io.github.claw4j 依赖**，这是刻意的：
          MCP server 与宿主之间只有协议，没有代码。它不需要 Claw4J 的任何类型，
          也不需要知道将来谁把它接进去——这正是 MCP 这一层的价值。

          starter 带三样：spring-boot-starter-web（servlet 容器）、
          mcp-spring-webmvc（WebMvcStreamableServerTransportProvider，/mcp 那个端点）、
          spring-ai-mcp-annotations（@McpTool 与注解扫描器，于是工具照常写成带注解的普通方法，
          不必手写 JSON Schema）。传输取 Streamable HTTP 不取 SSE：2025 版协议以它取代 SSE，
          宿主那边的 HttpClientStreamableHttpTransport 对的就是它。
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
        </dependency>

        <!-- 日志实现不再单独引：web starter 带 spring-boot-starter-logging（logback），
             也不再需要 logback.xml 把出口改到 stderr——那是 stdio 传输的约束，
             stdout 是协议通道；HTTP 之后日志走哪儿都不影响协议。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 打成能 java -jar 直接跑的可执行包：这一层的样本必须是"一个独立程序"，
                 而不是"一段要在宿主里被 new 出来的代码"。 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <mainClass>io.github.claw4j.example.mcp.server.McpServerApplication</mainClass>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!--
                      这条用例要把 server 起成**另一个进程**，于是需要把"本模块的完整 classpath"
                      原样传给子进程。surefire 默认给测试的是一条 manifest-only 的 booter jar，
                      java.class.path 指向它——能不能加载到类取决于 jar 的 Manifest 而不是目录结构，
                      换台机器就可能加载不到，报出来是 ClassNotFoundException，指向的是子进程
                      而不是真正的原因。关掉它，java.class.path 就是那串真实路径。
                    -->
                    <useManifestOnlyJar>false</useManifestOnlyJar>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
